# Copy to .env and fill in. .env is git-ignored; never commit real values.

# development | staging | production
APP_ENV=development
APP_VERSION=local

POSTGRES_DB=ideaboard
POSTGRES_USER=ideaboard
# Required: choose any local password.
POSTGRES_PASSWORD=

# Optional: enables Claude-powered log analysis. Leave empty for the rule-based fallback.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Set to true to make /ready fail (used to demo the rollback path).
SIMULATE_UNHEALTHY=false
